{
  "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedKeys": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "**/*.js",
      "**/*.cjs",
      "**/*.mjs",
      "**/*.jsx",
      "**/*.ts",
      "**/*.cts",
      "**/*.mts",
      "**/*.tsx",
      "**/*.css",
      "**/*.scss",
      "**/*.json",
      "**/*.jsonc",
      "!**/package.json",
      "!./node_modules/**/*"
    ]
  },
  "formatter": {
    "attributePosition": "auto",
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "attributePosition": "auto",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    },
    "jsxRuntime": "reactClassic"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noSwitchDeclarations": "off",
        "noUnusedImports": {
          "fix": "safe",
          "level": "error",
          "options": {}
        },
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "hooks": [
              {
                "closureIndex": 0,
                "dependenciesIndex": 1,
                "name": "useDebounceEffect"
              }
            ]
          }
        }
      },
      "performance": {
        "noDelete": "info"
      },
      "recommended": true,
      "style": {
        "useImportType": "off"
      },
      "suspicious": {
        "noGlobalIsNan": "info",
        "noUnknownAtRules": "info",
        "useAwait": "error"
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true,
    "useIgnoreFile": true
  }
}
