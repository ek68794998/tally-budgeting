# Make a copy of this file and name it appropriately for your environment;
# for example, `.env.development.local` for your local development environment.
# Make sure to fill in all blank values in the REQUIRED section, and adjust others
# as needed.

## REQUIRED

# Postgres configuration
POSTGRES_CONNECTION_STRING=
POSTGRES_POOL_MAXIMUM=10

## OPTIONAL

# Log level for backend telemetry: error, warn, info, http, debug
LOG_LEVEL=http
