{
  "name": "tally-budgeting",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "dev:db": "docker compose -f deployment/docker-compose.dev.yml up db",
    "dev:db:down": "docker compose -f deployment/docker-compose.dev.yml down",
    "dev:db:seed": "docker compose -f deployment/docker-compose.dev.yml exec -T db psql -U tally -d tally -v ON_ERROR_STOP=1 -q < deployment/seed.dev.sql",
    "dev:db:up": "pnpm dev:db -d",
    "diagnostic": "echo \"Turbo $(turbo --version); Node $(node -v); NPM $(npm -v); PNPM $(pnpm -v); TS(C) $(tsc -v)\"",
    "docker:build": "sh -c 'docker build --platform \"${1:-linux/amd64}\" -f apps/web/Dockerfile -t tally-budgeting . && docker save -o tally-budgeting.tar tally-budgeting' --",
    "docker:down": "docker compose -f deployment/docker-compose.yml down",
    "docker:logs": "docker compose -f deployment/docker-compose.yml logs -f",
    "docker:up": "docker compose -f deployment/docker-compose.yml up -d",
    "fix:biome": "biome check --write .",
    "lint": "turbo run lint; rc1=$?; pnpm lint:biome; rc2=$?; exit $((rc1 + rc2))",
    "lint:biome": "biome check",
    "test": "vitest --no-watch",
    "test:coverage": "vitest --coverage --no-watch",
    "test:ui": "vitest --ui",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@vitest/coverage-v8": "4.1.12",
    "happy-dom": "20.8.9",
    "turbo": "2.11.10",
    "typescript": "5.9.2",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  }
}
